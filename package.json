{
  "name": "gud-cli",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "check": "turbo run typecheck && biome check --diagnostic-level error .",
    "fix": "biome check --diagnostic-level error . --write",
    "test": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "release": "sh scripts/release.sh",
    "reset-node-modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && bun pm cache rm && bun install",
    "version": "changeset version && bun install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^2.29.5",
    "turbo": "^2.5.5"
  },
  "packageManager": "bun@1.4.3"
}
