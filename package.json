{
  "name": "gud-cli",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "format": "biome format --write .",
    "lint": "biome lint --diagnostic-level error .",
    "lint:fix": "bun run lint --fix",
    "lint:fix:unsafe": "bun run lint:fix --unsafe",
    "test": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "release": "sh scripts/release.sh",
    "reset-node-modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && bun pm cache rm && bun install",
    "version": "changeset version && bun install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@changesets/cli": "^2.29.5",
    "turbo": "^2.5.5"
  },
  "packageManager": "bun@1.4.3"
}
