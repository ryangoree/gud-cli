{
  "name": "@gud/cli",
  "version": "1.0.0-beta.8",
  "description": "A framework for building flexible and extensible CLIs",
  "license": "Apache-2.0",
  "author": "ryan goree (https://github.com/ryangoree)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangoree/gud-cli.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "NODE_ENV=development tsx src/sandbox/index.ts",
    "dev:watch": "NODE_ENV=development tsx --watch src/sandbox/index.ts",
    "prod": "tsx src/sandbox/index.ts",
    "prod:watch": "tsx --watch src/sandbox/index.ts",
    "test": "vitest run --reporter=tree",
    "test:watch": "vitest --reporter=tree",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/prompts": "^2.4.9",
    "cliui": "^8.0.1",
    "prompts": "^2.4.2",
    "yargs-parser": "^22.0.0"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/yargs-parser": "^21.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts"
      ],
      "testing": [
        "./dist/testing.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "gud",
    "cli",
    "command",
    "option",
    "arguments",
    "argv"
  ]
}
