{
  "name": "@gud/cli-menu",
  "version": "1.0.0-beta.5",
  "description": "Adds command menus to Gud CLI apps.",
  "license": "Apache-2.0",
  "author": "ryan goree (https://github.com/ryangoree)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangoree/gud-cli.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "dev": "NODE_ENV=development tsx example/cli.ts",
    "test": "vitest run --reporter=tree",
    "test:watch": "vitest --reporter=tree",
    "test:ci": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@gud/cli": "^1.0.0-beta.7"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "colors": "^1.4.0"
  },
  "devDependencies": {
    "@gud/cli": "^1.0.0-beta.7",
    "@types/node": "^22",
    "@types/prompts": "^2.4.9",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "keywords": [
    "gud",
    "cli",
    "menu",
    "command",
    "prompt"
  ]
}
